{
  "name": "artifacts-studio",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "build": {"command": "node build.mjs"},
  "artifacts": [{"binding": "ARTIFACTS", "namespace": "artifacts-studio"}],
  "d1_databases": [{"binding": "DB", "database_name": "artifacts-studio", "database_id": "REPLACE_WITH_CREATED_DATABASE_ID"}],
  "vars": {"OWNER_EMAILS": "REPLACE_WITH_YOUR_VERIFIED_EMAIL"}
}
